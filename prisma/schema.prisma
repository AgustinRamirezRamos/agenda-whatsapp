// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Negocio {
  id              String    @id @default(uuid())
  nombre          String
  telefonoOficial String    @unique //El número de WhatsApp del local
  creadoEn        DateTime  @default(now())
  
  usuarios        Usuario[]
  clientes        Cliente[]
  turnos          Turno[]
}

model Usuario {
  id        String   @id @default(uuid())
  clerkId   String   @unique //El ID que nos devuelve Clerk al iniciar sesión
  nombre    String
  email     String   @unique
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id])
}

model Cliente {
  id        String   @id @default(uuid())
  telefono  String
  nombre    String?
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id])
  turnos    Turno[]

  @@unique([telefono, negocioId]) //Un mismo cliente (teléfono) puede ir a distintos negocios
}

model Turno {
  id          String   @id @default(uuid())
  fechaHora   DateTime
  estado      String   @default("PENDIENTE") //PENDIENTE, CONFIRMADO, CANCELADO
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  negocioId   String
  negocio     Negocio  @relation(fields: [negocioId], references: [id])
}